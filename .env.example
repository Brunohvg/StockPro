# ==============================================================================
# StockPro / Bibelo - contrato de ambiente para Coolify
# Nunca versione credenciais reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# Minimo para subir via Dockerfile no Coolify
# ------------------------------------------------------------------------------
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False

# Dominio publico. Com DOMAIN definido, ALLOWED_HOSTS e CSRF podem ser derivados.
DOMAIN=estoque.seudominio.com.br
SITE_URL=https://estoque.seudominio.com.br

# PostgreSQL gerenciado pelo Coolify (recomendado)
DATABASE_URL=postgresql://usuario:senha@host-interno:5432/stockpro

# Django
DJANGO_ADMIN_PATH=ops19x/
PORT=8000

# Admin inicial. O entrypoint cria somente se ainda nao existir.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@seudominio.com.br
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ------------------------------------------------------------------------------
# Alternativa ao DATABASE_URL
# Use DB_* somente se preferir configurar o PostgreSQL campo a campo.
# ------------------------------------------------------------------------------
# DB_TYPE=postgres
# DB_HOST=postgres
# DB_NAME=stockpro
# DB_USER=stockpro
# DB_PASSWORD=troque-esta-senha
# DB_PORT=5432

# Overrides opcionais. Normalmente DOMAIN/SITE_URL ja bastam.
# ALLOWED_HOSTS=estoque.seudominio.com.br
# CSRF_TRUSTED_ORIGINS=https://estoque.seudominio.com.br

# ------------------------------------------------------------------------------
# Celery / Redis - opcional no primeiro deploy
# Para jobs em background, crie Redis e um worker separado usando a mesma imagem.
# ------------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# CELERY_CONCURRENCY=2

# Backup
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30

# IA - opcionais
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# WhatsApp de suporte (sem +)
WHATSAPP_SUPPORT=5511999999999
