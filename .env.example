# StockPro / Bibelo - Coolify Docker Compose
# Copie as variaveis para Environment Variables no Coolify.
# NUNCA grave valores reais neste arquivo versionado.

# O Coolify fornece automaticamente SERVICE_HEX_64_DJANGO,
# SERVICE_FQDN_WEB_8000 e SERVICE_URL_WEB_8000 pelo Compose.
# Configure o dominio no painel do servico web (porta 8000).

# OBRIGATORIO - PostgreSQL 17 ja existente (URL INTERNA)
DATABASE_URL=postgresql://usuario:senha@host-interno:5432/stockpro

# PRIMEIRO ACESSO - admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@seudominio.com.br
DJANGO_SUPERUSER_PASSWORD=SUBSTITUIR_SENHA_FORTE

# DJANGO / SERVIDOR - opcionais (defaults no Compose)
DJANGO_ADMIN_PATH=ops19x/
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# IA - escolha uma ou mais; deixadas vazias, recursos de IA podem ficar indisponiveis.
# Ordem de failover atual no codigo: Groq > Gemini > OpenAI > xAI (Grok).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=grok-2-latest
AI_MAX_TOKENS=500

# SUPORTE
WHATSAPP_SUPPORT=5511999999999

# BACKUPS
BACKUP_RETENTION_DAYS=30

# Redis e Celery configurados internamente no docker-compose.coolify.yml:
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
#
# Ja definidos automaticamente no Compose:
# SECRET_KEY <- SERVICE_HEX_64_DJANGO
# DEBUG=False
# DOMAIN <- SERVICE_FQDN_WEB_8000
# SITE_URL <- SERVICE_URL_WEB_8000
# PORT=8000
# BACKUP_DIR=/data/backups
