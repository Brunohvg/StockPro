# ==============================================================================
# StockPro V16 - Variáveis de Produção
# Copie para .env e preencha os valores
# ==============================================================================

# Imagem Docker
STOCKPRO_IMAGE=brunobh51/stockpro:latest

# Django
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
DEBUG=False
DOMAIN=stockpro.seudominio.com.br
ALLOWED_HOSTS=stockpro.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://stockpro.seudominio.com.br
DJANGO_ADMIN_PATH=ops19x/

# Database (Postgres externo)
DB_HOST=postgres_stockpro
DB_NAME=stockpro
DB_USER=stockpro
DB_PASSWORD=SENHA_FORTE_AQUI
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=2

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Recursos do Swarm
WEB_REPLICAS=1
WORKER_REPLICAS=1
WEB_CPU_LIMIT=1
WEB_MEMORY_LIMIT=512M
WORKER_CPU_LIMIT=1
WORKER_MEMORY_LIMIT=512M
REDIS_MAXMEMORY=256mb
REDIS_MEMORY_LIMIT=512M

# Backup
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30

# Superuser
DJANGO_SUPERUSER_EMAIL=admin@seudominio.com.br
DJANGO_SUPERUSER_PASSWORD=SENHA_ADMIN_AQUI

# IA (pelo menos 1 chave)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# WhatsApp de suporte (sem +, ex: 5511999999999)
WHATSAPP_SUPPORT=5511999999999
